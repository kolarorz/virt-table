{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@virt-table/vanilla": ["../packages/vanilla/dist/index.d.ts"],
      "@virt-table/vanilla/plugins": ["../packages/vanilla/dist/plugins/index.d.ts"],
      "@virt-table/vanilla/plugins/*": ["../packages/vanilla/dist/plugins/*"],
      "@virt-table/vanilla/components": ["../packages/vanilla/dist/components/index.d.ts"],
      "@virt-table/react": ["../packages/react/dist/index.d.ts"],
      "@virt-table/vue": ["../packages/vue/dist/index.d.ts"]
    }
  },
  "include": [
    ".vitepress/**/*.ts",
    ".vitepress/**/*.d.ts",
    ".vitepress/**/*.vue",
    "**/*.md"
  ]
}
