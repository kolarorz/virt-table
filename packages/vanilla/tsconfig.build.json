{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  // `*.test-d.ts` 是类型级断言（见 tsconfig.typecheck.json），不能进产物
  "exclude": ["src/**/*.test.ts", "src/**/*.test-d.ts"]
}
